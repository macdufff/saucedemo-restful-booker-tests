{
  "name": "saucedemo-restful-booker-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI (Sauce Demo) + API (Restful Booker) test suite",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui --project=ui-login",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=ui --project=ui-login --headed",
    "test:report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "codegen": "playwright codegen https://www.saucedemo.com",
    "generate:test": "tsx bonus/generate-test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "zod": "^3.24.1"
  }
}
